<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:Mostlylucid.LucidView.Markdown;assembly=Mostlylucid.LucidView.Markdown"
        xmlns:controls="clr-namespace:LucidReader.Views.Controls"
        x:Class="LucidReader.Views.MainWindow"
        Title="mylo"
        Icon="/Assets/mylo.png"
        Width="1280" Height="820"
        MinWidth="820" MinHeight="520"
        Background="{DynamicResource ListBackgroundBrush}"
        TransparencyLevelHint="AcrylicBlur,Blur,None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        ExtendClientAreaTitleBarHeightHint="-1">

    <Window.Resources>
        <controls:PathToBitmapConverter x:Key="PathToBitmapConverter" />
    </Window.Resources>

    <!--
        There is deliberately no Window.KeyBindings block here.

        This file used to declare ten KeyBinding entries with no modifier at
        all (J K N P M S R O T and OemQuestion). Avalonia evaluates
        KeyBindings from the KeyboardDevice, walking up from the focused
        element BEFORE the routed KeyDown is raised, and KeyBinding.TryHandle
        has no focus or text-input guard: a focused TextBox never gets the
        chance to claim the key. Typing "compositor" into the search box
        therefore opened a browser (o), wrote read state (m), wrote starred
        state (s), started a network fetch (r) and opened the modal tags
        dialog (t), all mid-word.

        Every shortcut, letter-only and command-modifier alike, is now
        resolved in one place: LucidReader.Services.ReaderShortcuts, driven
        from a bubbling KeyDown handler on this window (see
        MainWindow.Actions.cs). That handler runs after the focused control
        has had its turn and consults focus before acting, and being a routed
        event rather than a KeyBinding it is also reachable from the UI test
        harness, which the KeyBindings never were.
    -->

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!--
            The in-window menu bar, for Windows and Linux only, which have no
            system menu bar to put the application menu in. It starts hidden
            and is only populated and shown by InstallWindowMenu
            (MainWindow.Menu.cs) when the platform is not macOS, so on macOS
            this Auto row measures to zero and Grid.Row 1 below still holds
            the title-bar band the traffic lights are drawn over.

            Populated from code rather than declared here: the same
            LucidReader.Models.ReaderMenu description builds this and the
            macOS NativeMenu, and two hand-kept copies of a menu structure
            drift.
        -->
        <Menu Grid.Row="0" x:Name="WindowMenu" IsVisible="False"
              Background="{DynamicResource SidebarBackgroundBrush}" />

        <!--
            One unified toolbar spanning the full window width, the way Mail
            has a single toolbar rather than a per-pane one. It sits at
            Grid.Row="0" so it is the row the OS draws the traffic lights
            over once the client area is extended (Step 8): the left margin
            below clears them horizontally, and the row's own height
            (buttons plus 10px top/bottom padding) comfortably contains the
            platform-default title bar band vertically. Search lives here
            too, not in the item-list column, matching Mail. Settings sits
            at the right end of this same row rather than in the status bar,
            which now only shows StatusText.
        -->
        <!--
            DoubleTapped zooms the window. With
            ExtendClientAreaToDecorationsHint the OS title bar band is drawn
            over by this toolbar, so the platform never sees the double click
            that normally zooms a macOS window: the app has to do it. The
            handler ignores taps that landed on a control.
        -->
        <Border Grid.Row="1" Background="{DynamicResource SidebarBackgroundBrush}"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource HairlineBrush}"
                PointerPressed="OnTitleBarPointerPressed"
                DoubleTapped="OnTitleBarDoubleTapped">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="80,10,12,10">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!--
                        The layout button, first in the row because that is
                        where macOS puts the sidebar toggle and because the
                        pane it collapses first is the one directly below it.
                        Icon-only and narrow: another word here would cost the
                        search box its width before it bought any clarity the
                        icon does not already give.

                        The icon is a PaneLayoutIcon, drawn from the current
                        mode rather than a fixed glyph, so it shows which panes
                        are on screen and which one goes next. See
                        Views/Controls/PaneLayoutIcon.cs for why it is not an
                        SF Symbol.
                    -->
                    <Button x:Name="LayoutButton" Classes="row-toolbar icon-toolbar"
                            ToolTip.Tip="{Binding LayoutButtonTip}"
                            Click="OnLayoutButtonClicked">
                        <controls:PaneLayoutIcon x:Name="LayoutIcon"
                                                 Width="18" Height="14"
                                                 Mode="{Binding LayoutMode}"
                                                 StrokeBrush="{DynamicResource RowTitleBrush}"
                                                 PaneBrush="{DynamicResource RowSecondaryBrush}" />
                    </Button>
                    <Button x:Name="AddFeedButton" Content="Add feed" Classes="row-toolbar"
                            Command="{Binding AddFeedCommand}" />
                    <Button x:Name="RefreshAllButton" Content="Refresh all" Classes="row-toolbar"
                            Command="{Binding RefreshAllCommand}" />
                    <!--
                        The same per-feed settings the sidebar context menu
                        opens, reachable without a right-click. Mail exposes
                        mailbox settings from the menu bar as well as the
                        context menu, and a ContextMenu opens into its own
                        PopupRoot, which the UI test harness can neither
                        locate nor capture - so the context menu alone would
                        leave this flow permanently unverifiable.
                    -->
                    <Button x:Name="FeedSettingsButton" Content="Feed settings" Classes="row-toolbar"
                            IsEnabled="{Binding IsFeedSelected}"
                            Click="OnToolbarFeedSettingsClicked" />
                    <!--
                        Resume is offered here as well as on the sidebar
                        context menu, for the same two reasons the per-feed
                        settings button exists: a ContextMenu opens into its
                        own PopupRoot that the UI test harness can neither
                        click nor capture, and a right-click-only route hides
                        the one action that gets a dead feed working again.
                        Collapsed rather than disabled when the selection is
                        not a paused feed, so it reads as an exception state.
                    -->
                    <Button x:Name="ResumeFeedButton" Content="Resume feed" Classes="row-toolbar"
                            IsVisible="{Binding IsPausedFeedSelected}"
                            Click="OnToolbarResumeFeedClicked" />
                    <!--
                        The two tag actions, offered here as well as on the tag
                        row's context menu, for the same two reasons the Feed
                        settings and Resume buttons exist: a ContextMenu opens
                        into its own PopupRoot the UI test harness can neither
                        click nor capture, and a right-click-only route hides
                        the only way to correct a mistyped tag across every
                        article carrying it. Collapsed rather than disabled
                        when the selection is not a tag, so the toolbar stays
                        the length it was for everyone who does not use tags.
                    -->
                    <Button x:Name="RenameTagButton" Content="Rename tag" Classes="row-toolbar"
                            IsVisible="{Binding IsTagSelected}"
                            Click="OnRenameTagClicked" />
                    <Button x:Name="DeleteTagButton" Content="Delete tag" Classes="row-toolbar"
                            IsVisible="{Binding IsTagSelected}"
                            Click="OnDeleteTagClicked" />
                    <!--
                        Import OPML and Export OPML used to sit here, and no
                        longer do. Both are operations a reader performs
                        perhaps twice in the life of a profile, and they were
                        two of seven buttons crowding a toolbar whose other
                        job is to hold the search box. They are now under
                        File, and only under File. The comment they replaced
                        argued they had to be on the toolbar because this
                        window had no menu bar; it does now.
                    -->
                </StackPanel>

                <!--
                    Search, and the one control that scopes it. Mail offers
                    the same choice rather than deciding silently: search
                    spans everything by default, and the toggle narrows it to
                    the selected feed or folder. Disabled on a smart row,
                    which is not a scope. The label follows the selection
                    (SearchScopeLabel) so it never says "This feed" over a
                    folder.
                -->
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Stretch"
                      MaxWidth="470">
                    <TextBox Grid.Column="0" x:Name="SearchBox"
                             Watermark="Search all articles"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Stretch"
                             MinWidth="120"
                             MaxWidth="360"
                             Margin="0,0,6,0"
                             Text="{Binding SearchText, Mode=TwoWay}" />
                    <ToggleButton Grid.Column="1" x:Name="SearchScopeButton" Classes="row-toolbar"
                                  VerticalAlignment="Center"
                                  Content="{Binding SearchScopeLabel}"
                                  IsEnabled="{Binding CanScopeSearchToSelection}"
                                  IsChecked="{Binding SearchScopeToSelection, Mode=TwoWay}"
                                  ToolTip.Tip="Limit search to the selected feed or folder" />
                </Grid>

                <Button Grid.Column="2" x:Name="SettingsButton" Content="Settings" Classes="row-toolbar"
                        VerticalAlignment="Center"
                        Command="{Binding OpenSettingsCommand}" />
            </Grid>
        </Border>

        <!--
            Named, because the layout button collapses panes by writing these
            column widths from code (MainWindow.Layout.cs). Hiding the pane
            content alone is not enough: a zero-content column still holds its
            260px open.
        -->
        <Grid Grid.Row="2" x:Name="PaneGrid" ColumnDefinitions="260,4,340,4,*">

            <!--
                The sidebar is the one translucent surface (Task 8a Step 8);
                the list and reading panes stay opaque, exactly as Mail does
                it. It no longer carries its own top-clearance padding: the
                unified toolbar above already occupies the title-bar band.
            -->
            <Border Grid.Column="0" x:Name="SidebarPane" Background="{DynamicResource SidebarBackgroundBrush}">
                <ScrollViewer>
                    <ItemsControl x:Name="SidebarSections" ItemsSource="{Binding Sidebar}" Margin="0,8,0,12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel IsVisible="{Binding IsVisible}">
                                    <ToggleButton Classes="sidebar-header" IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Grid.Column="0" Text="&#x25BE;" Classes="chevron"
                                                       Classes.collapsed="{Binding IsCollapsed}" Margin="0,0,6,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding HeaderText}" Classes="section-header" />
                                            <TextBlock Grid.Column="2" Text="{Binding UnreadLabel}" Classes="section-header" />
                                        </Grid>
                                    </ToggleButton>

                                    <!--
                                        One ItemsControl (not ListBox) per section: two ListBoxes
                                        TwoWay-bound to the same SelectedFeedNode would fight over
                                        it, since each rejects a SelectedItem the other one owns.
                                        Selection is instead a PointerPressed on the row Border
                                        (MainWindow.axaml.cs.OnFeedNodePointerPressed), and the
                                        row's own IsSelected flag drives the selected visual, kept
                                        in sync by SelectedFeedNode's setter.
                                    -->
                                    <ItemsControl ItemsSource="{Binding Nodes}" IsVisible="{Binding IsExpanded}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Classes="node-row" Classes.selected="{Binding IsSelected}"
                                                        PointerPressed="OnFeedNodePointerPressed">
                                                    <!--
                                                        Feed-only actions (Task 12). The same template renders
                                                        smart rows, folders and feeds, so the ContextMenu is
                                                        attached to every row, but each item here acts on a
                                                        FeedId and its handler bails out when there is none.
                                                        Offering them on a folder or a smart row would mean a
                                                        click that does nothing and says nothing, so every item
                                                        is gated on FeedTreeNode.IsFeed instead.
                                                    -->
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Refresh" Click="OnRefreshFeedClicked"
                                                                      IsVisible="{Binding IsFeed}" />
                                                            <!--
                                                                Gated on IsAutoPaused, not IsFeed: this is the
                                                                only way back for a feed the Core layer paused
                                                                after 20 straight failures, and on a healthy
                                                                feed it would mean nothing.
                                                            -->
                                                            <MenuItem Header="Resume" Click="OnResumeFeedClicked"
                                                                      IsVisible="{Binding IsAutoPaused}" />
                                                            <MenuItem Header="Rename" Click="OnRenameFeedClicked"
                                                                      IsVisible="{Binding IsFeed}" />
                                                            <Separator IsVisible="{Binding IsFeed}" />
                                                            <MenuItem Header="Mark all read" Click="OnMarkFeedReadClicked"
                                                                      IsVisible="{Binding IsFeed}" />
                                                            <Separator IsVisible="{Binding IsFeed}" />
                                                            <MenuItem Header="Feed settings..." Click="OnFeedSettingsClicked"
                                                                      IsVisible="{Binding IsFeed}" />
                                                            <Separator IsVisible="{Binding IsFeed}" />
                                                            <MenuItem Header="Unsubscribe" Click="OnUnsubscribeFeedClicked"
                                                                      IsVisible="{Binding IsFeed}" />
                                                            <!--
                                                                The two tag-only actions, gated on IsTag the
                                                                same way the feed ones are gated on IsFeed.
                                                                Both are also on the toolbar (RenameTagButton
                                                                and DeleteTagButton) whenever a tag is
                                                                selected, because a ContextMenu opens into its
                                                                own PopupRoot that the UI test harness can
                                                                neither click nor capture, so a right-click
                                                                would leave both flows unverifiable.
                                                            -->
                                                            <MenuItem Header="Rename tag..." Click="OnRenameTagClicked"
                                                                      IsVisible="{Binding IsTag}" />
                                                            <MenuItem Header="Delete tag" Click="OnDeleteTagClicked"
                                                                      IsVisible="{Binding IsTag}" />
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="{Binding Indent}">
                                                        <!--
                                                            16px favicon slot, always reserved (Width fixed
                                                            regardless of HasIcon) so feed names stay aligned
                                                            whether or not an icon loaded. Folders and smart
                                                            rows have no IconPath/IconUrl at all, so this
                                                            column is simply always empty for them - no glyph
                                                            change needed there.
                                                        -->
                                                        <Border Grid.Column="0" Width="16" Height="16" Margin="0,0,6,0"
                                                                CornerRadius="3" Background="{DynamicResource RowHoverBrush}"
                                                                IsVisible="{Binding ShowIconPlaceholder}" />
                                                        <Image Grid.Column="0" Width="16" Height="16" Margin="0,0,6,0"
                                                               Source="{Binding IconPath, Converter={StaticResource PathToBitmapConverter}}"
                                                               IsVisible="{Binding HasIcon}" />
                                                        <!--
                                                            A tag row fills the same 16px slot a feed's
                                                            favicon occupies, with a hash rather than an
                                                            icon, so tag names line up with feed names
                                                            down the sidebar instead of sitting 22px to
                                                            their left. Secondary weight: the glyph says
                                                            what kind of row this is, the name is what is
                                                            being read.
                                                        -->
                                                        <TextBlock Grid.Column="0" Text="#" Classes="row-secondary"
                                                                   Width="16" Margin="0,0,6,0"
                                                                   TextAlignment="Center"
                                                                   IsVisible="{Binding IsTag}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Classes="row-title" />
                                                        <!--
                                                            row-problem, not row-secondary: this marker is the
                                                            only sign in the sidebar that a feed has stopped
                                                            working, and at secondary alpha it was the dimmest
                                                            thing on the row. ProblemTip rather than LastError
                                                            so an auto-paused feed says it is paused even when
                                                            no error text was recorded.
                                                        -->
                                                        <TextBlock Grid.Column="2" Text="!" Classes="row-problem"
                                                                   Margin="6,0,0,0"
                                                                   IsVisible="{Binding HasProblem}"
                                                                   ToolTip.Tip="{Binding ProblemTip}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding UnreadLabel}" Classes="row-secondary"
                                                                   Margin="6,0,0,0"
                                                                   IsVisible="{Binding HasUnread}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" x:Name="SidebarSplitter" ResizeDirection="Columns" />

            <Grid Grid.Column="2" x:Name="ItemListPane" RowDefinitions="Auto,*"
                  Background="{DynamicResource ListBackgroundBrush}">
                <!--
                    The per-feed update line. One row, one sentence, one
                    control, at the top of the column whose articles it
                    describes. It is not on the toolbar for two reasons: that
                    toolbar is window-wide and already carries six controls
                    plus the search box, and this describes the selected feed
                    rather than the window.

                    Hidden outright on a folder or a smart row. A folder groups
                    feeds with separate schedules and a smart row spans every
                    feed there is, so neither has a last-updated time, a
                    next-due time, or anything for a per-feed Refresh to act
                    on. See LucidReader.Models.FeedUpdateSummary.

                    Every binding here names a property on MainWindow
                    (MainWindow.FeedUpdate.cs). Compiled bindings are off in
                    this project, so a name that does not resolve fails
                    silently and the line simply never appears. The TextBlock's
                    x:Name is deliberately not FeedUpdateText: x:Name generates
                    a field of that name on this class, which would collide
                    with the bound property.
                -->

                <!--
                    A segmented control, not raw RadioButtons: same three
                    bindings as before (IsFilterAll/Unread/Starred), only the
                    RadioButton.Theme changes what they look like. See
                    SegmentedRadioButtonTheme in Styles/Reader.axaml.
                -->
                <!--
                    Filter and the feed-update line share one row to save
                    vertical space in a pane that is mostly list. A WrapPanel
                    rather than a Grid because the item list column is
                    resizable and can be dragged narrow: when the two no
                    longer fit side by side the update line drops to its own
                    line instead of the Refresh button being clipped off the
                    right edge.
                -->
                <WrapPanel Grid.Row="0" x:Name="ItemListHeaderBar" Orientation="Horizontal"
                           Margin="10,8,10,8">
                <Border Classes="segmented-container" VerticalAlignment="Center" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <RadioButton x:Name="FilterAll" Content="All" GroupName="ItemFilter"
                                     Theme="{StaticResource SegmentedRadioButtonTheme}"
                                     IsChecked="{Binding IsFilterAll, Mode=TwoWay}" />
                        <RadioButton x:Name="FilterUnread" Content="Unread" GroupName="ItemFilter"
                                     Theme="{StaticResource SegmentedRadioButtonTheme}"
                                     IsChecked="{Binding IsFilterUnread, Mode=TwoWay}" />
                        <RadioButton x:Name="FilterStarred" Content="Starred" GroupName="ItemFilter"
                                     Theme="{StaticResource SegmentedRadioButtonTheme}"
                                     IsChecked="{Binding IsFilterStarred, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                    <!--
                        StackPanel, not the old Grid with a star column: inside
                        a WrapPanel a child is measured at its desired size, so
                        a star column would have nothing to fill and the
                        Refresh button would sit hard against the text.
                    -->
                    <StackPanel x:Name="FeedUpdateStrip" Orientation="Horizontal"
                                VerticalAlignment="Center" Spacing="6"
                                IsVisible="{Binding IsFeedUpdateVisible}">
                        <TextBlock x:Name="FeedUpdateLineText"
                                   Text="{Binding FeedUpdateShortText}" Classes="row-secondary"
                                   ToolTip.Tip="{Binding FeedUpdateText}"
                                   VerticalAlignment="Center" />
                        <!-- Glyph, not the word "Refresh": the label alone was
                             wider than the time it sits next to. -->
                        <Button x:Name="FeedUpdateRefreshButton"
                                Classes="feed-update-refresh" Content="&#x21BB;"
                                IsVisible="{Binding CanRefreshSelectedFeed}"
                                ToolTip.Tip="Refresh this feed now"
                                Click="OnFeedUpdateRefreshClicked" />
                    </StackPanel>
                </WrapPanel>

                <ListBox Grid.Row="1" x:Name="ItemList"
                         ItemsSource="{Binding ItemRows}"
                         SelectedItem="{Binding SelectedItemRow, Mode=TwoWay}"
                         ItemContainerTheme="{StaticResource ReaderListBoxItemTheme}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!--
                                Mail's row shape: an unread-dot gutter, a
                                semibold single-line title, a secondary line
                                (feed name left, relative date right), then up
                                to two lines of plain-text snippet. RowActions
                                sits over the top-right corner and is only
                                made visible by the ListBoxItem:pointerover
                                selector in Styles/Reader.axaml.
                            -->
                            <!--
                                A departure from Mail, recorded deliberately:
                                Mail has no list thumbnails. Reeder and
                                NetNewsWire do, and that third column is the
                                user's choice - the sidebar and reading pane
                                stay Mail-like, only this list gains a
                                thumbnail on the right. The column is Auto,
                                not a fixed width, so a row with no thumbnail
                                (HasThumbnail false) simply has nothing in it
                                and the text column claims the full row
                                rather than leaving a grey placeholder box.
                            -->
                            <Grid ColumnDefinitions="18,*,Auto">
                                <Ellipse Grid.Column="0" Width="7" Height="7"
                                         Fill="{DynamicResource UnreadDotBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Top"
                                         Margin="0,6,0,0"
                                         IsVisible="{Binding IsUnread}" />

                                <StackPanel Grid.Column="1" Spacing="3" Margin="0,10,12,10">
                                    <TextBlock Text="{Binding Title}" Classes="row-title"
                                               FontWeight="{Binding TitleWeight}" />

                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Grid.Column="0" Text="{Binding FeedName}" Classes="row-secondary" />
                                        <TextBlock Grid.Column="1" Text="{Binding StarGlyph}" Classes="row-secondary"
                                                   IsVisible="{Binding IsStarred}" Margin="8,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding RelativeDate}" Classes="row-secondary"
                                                   Margin="8,0,0,0" />
                                    </Grid>

                                    <!--
                                        Two preview lines, one shown at a
                                        time. An ordinary row previews the
                                        stored body; a search result previews
                                        the passage FTS5 says matched, with
                                        the query terms picked out, so the row
                                        can say why it is in the list. Named
                                        visibility properties rather than a
                                        negated binding: compiled bindings are
                                        off in this project, so a binding that
                                        does not resolve fails silently.

                                        The matched passage is a WrapPanel of
                                        one TextBlock per word rather than a
                                        single TextBlock, because a TextBlock
                                        has one Foreground and one FontWeight
                                        and this line needs two of each. See
                                        Models/SearchSnippet.cs.
                                    -->
                                    <TextBlock Text="{Binding Snippet}" Classes="row-snippet"
                                               IsVisible="{Binding IsPlainSnippetVisible}"
                                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />

                                    <ItemsControl ItemsSource="{Binding SnippetWords}"
                                                  IsVisible="{Binding IsSearchSnippetVisible}"
                                                  MaxHeight="34" ClipToBounds="True">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text}"
                                                           Classes="row-snippet"
                                                           Classes.snippet-match="{Binding IsMatch}"
                                                           Margin="0,0,4,0" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Border Grid.Column="2" Width="56" Height="56"
                                        Margin="0,10,12,10" CornerRadius="6"
                                        IsVisible="{Binding HasThumbnail}"
                                        ClipToBounds="True">
                                    <Image Source="{Binding ThumbnailPath, Converter={StaticResource PathToBitmapConverter}}"
                                           Stretch="UniformToFill" Width="56" Height="56" />
                                </Border>

                                <controls:RowActions Grid.Column="1"
                                                      MarkRead="OnRowMarkReadClicked"
                                                      ToggleStar="OnRowToggleStarClicked"
                                                      OpenOriginal="OnRowOpenOriginalClicked" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="3" x:Name="ItemListSplitter" ResizeDirection="Columns" />

            <ScrollViewer Grid.Column="4" x:Name="ReadingScroll" Background="{DynamicResource ReadingBackgroundBrush}">
                <!--
                    The column gets an explicit Width, set from code-behind by
                    ApplyReadingColumnWidth (MainWindow.Reading.cs) via
                    ReadingColumnMetrics, and is centred so the margin grows
                    symmetrically as the pane widens. Not MaxWidth: that is
                    only a cap, so HorizontalAlignment=Center would shrink this
                    panel to its content's natural width and the margins would
                    stop being equal. lucidVIEW learned the same thing the hard
                    way - see MarkdownViewer/Views/MainWindow.Ruler.cs.

                    Width is not bound either, because it is not simply
                    ColumnWidth: it is that setting clamped to what this pane
                    can currently show, which changes when either splitter
                    moves, not only when the window resizes.

                    The reading body inside LucidMarkdownView has its own
                    inner ScrollViewer (in
                    Mostlylucid.LucidView.Markdown/LucidMarkdownView.axaml)
                    which, left at its default HorizontalScrollBarVisibility
                    of Auto, offers its content effectively infinite width
                    during measure regardless of what this pane is arranged
                    to, so the MaxWidth cap here alone was not enough to
                    force it to wrap; Styles/Reader.axaml disables that
                    inner ScrollViewer's horizontal scrollbar so it wraps
                    within whatever width this StackPanel gives it instead.
                -->
                <StackPanel x:Name="ReadingColumn" HorizontalAlignment="Center" Margin="0,24,0,24">
                    <!--
                        The hero, held to the same reading measure as the body
                        text below it (it stretches to the column's Width, no
                        separate cap needed) so it never grows wider than the
                        column. Same rounded
                        corners as the list thumbnail for visual consistency
                        between the two surfaces that show article artwork.
                    -->
                    <!--
                        A social card is a banner above the headline, not the
                        subject of the page. At 320 it took most of the first
                        screen and pushed the article title below the fold on a
                        laptop. 120 keeps it recognisable at the reading
                        column's width while the headline stays first.
                        UniformToFill plus ClipToBounds crops rather than
                        letterboxes, which is what these 1200x630 cards expect.
                    -->
                    <Border x:Name="HeroImageBorder" IsVisible="{Binding HasHero}"
                            CornerRadius="8" MaxHeight="120" Margin="0,0,0,16"
                            ClipToBounds="True">
                        <Image Source="{Binding HeroImagePath, Converter={StaticResource PathToBitmapConverter}}"
                               Stretch="UniformToFill" MaxHeight="120" />
                    </Border>

                    <TextBlock x:Name="ArticleTitleText" Text="{Binding ArticleTitle}" Classes="article-title" />
                    <TextBlock x:Name="ArticleMetaText" Text="{Binding ArticleMeta}" Classes="article-meta"
                               Margin="0,6,0,0" />

                    <!--
                        The article's tags, where they can be added and
                        removed. This is the primary route to tagging: the T
                        shortcut still opens the comma-separated dialog, but a
                        modal is something the UI test harness cannot dismiss,
                        so it cannot be the only way in, and a right-click
                        menu would be worse still (PopupRoot again). Every
                        control here is named for that reason.

                        A WrapPanel so a heavily tagged article wraps down the
                        column rather than pushing the Add button off the
                        right-hand edge. The whole strip is hidden when there
                        is no article, since a tag box over an empty reading
                        pane is an invitation to tag nothing.
                    -->
                    <WrapPanel x:Name="ArticleTagStrip" Orientation="Horizontal"
                               Margin="0,10,0,0" IsVisible="{Binding CanEditArticleTags}">
                        <ItemsControl x:Name="ArticleTagList" ItemsSource="{Binding ArticleTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="tag-chip">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="{Binding Name}" Classes="tag-chip-text"
                                                       VerticalAlignment="Center" />
                                            <!--
                                                A real Button, so the harness's Click
                                                drives it; the handler recovers which
                                                tag to remove from this button's own
                                                DataContext (the ArticleTagChip), the
                                                way the list's hover actions recover
                                                their ItemRow.
                                            -->
                                            <Button x:Name="RemoveTagButton" Classes="tag-chip-remove"
                                                    Content="&#x00D7;"
                                                    ToolTip.Tip="Remove this tag"
                                                    Click="OnRemoveArticleTagClicked" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBox x:Name="TagEntryBox" Width="150" Height="24"
                                 Margin="0,2,6,2" Padding="6,0" FontSize="11.5"
                                 VerticalContentAlignment="Center"
                                 Watermark="Add a tag"
                                 Text="{Binding TagEntryText, Mode=TwoWay}"
                                 KeyDown="OnTagEntryKeyDown" />
                        <Button x:Name="AddTagButton" Content="Add" Classes="row-toolbar"
                                Margin="0,2,0,2"
                                Click="OnAddArticleTagClicked" />
                    </WrapPanel>

                    <Border x:Name="OfflineBadge" IsVisible="{Binding ShowOfflineBadge}"
                            Padding="8,4" Margin="0,10,0,0" CornerRadius="4"
                            Background="{DynamicResource RowHoverBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding OfflineBadgeText}" Classes="row-secondary" />
                            <Button x:Name="FetchFullArticleButton" Content="Fetch full article"
                                    FontSize="11" Padding="6,0"
                                    IsVisible="{Binding CanFetchFullArticle}"
                                    Command="{Binding FetchFullArticleCommand}" />
                        </StackPanel>
                    </Border>

                    <Rectangle Classes="hairline" Margin="0,16,0,16" />

                    <md:LucidMarkdownView x:Name="ReadingPane" Markdown="{Binding ArticleMarkdown}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="3" Padding="8,4" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource HairlineBrush}"
                Background="{DynamicResource ListBackgroundBrush}">
            <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" Classes="row-secondary" />
        </Border>
    </Grid>
</Window>
