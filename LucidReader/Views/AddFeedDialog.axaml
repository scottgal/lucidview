<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="LucidReader.Views.AddFeedDialog"
        Title="Add Feed"
        Width="560" Height="560"
        MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource ListBackgroundBrush}">

    <!--
        Same palette fix SettingsDialog and FeedSettingsDialog apply: the base
        theme's accent is not the blue the rest of the app selects with, so the
        accent keys are rebound to AccentSelectionColor here too.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="{DynamicResource AccentSelectionColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="{DynamicResource AccentSelectionColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPressed" Color="{DynamicResource AccentSelectionColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeChecked" Color="{DynamicResource AccentSelectionColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" Color="{DynamicResource AccentSelectionColor}" />
        <SolidColorBrush x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" Color="{DynamicResource AccentSelectionColor}" />
        <SolidColorBrush x:Key="AccentButtonBackground" Color="{DynamicResource AccentSelectionColor}" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="{DynamicResource AccentSelectionColor}" />
        <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="{DynamicResource AccentSelectionColor}" />
        <SolidColorBrush x:Key="AccentButtonBorderBrush" Color="{DynamicResource AccentSelectionColor}" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.settings-card">
            <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Window.Styles>

    <Grid Margin="20,16,20,16" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,12">
            <TextBlock Text="Add a feed" Classes="row-title" FontSize="16" />
            <TextBlock Classes="row-secondary"
                       Text="Paste a feed address, or the address of a site and mylo will look for its feeds." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBox Grid.Column="0" x:Name="FeedUrlBox"
                     Watermark="https://example.com"
                     KeyDown="OnUrlKeyDown" />
            <Button Grid.Column="1" x:Name="FindButton" Content="Find" Width="80"
                    Margin="8,0,0,0" Click="OnFind" />
        </Grid>

        <TextBlock Grid.Row="2" x:Name="DiscoveryStatusText" Classes="row-secondary"
                   TextWrapping="Wrap" Margin="0,0,0,10" />

        <!--
            The chooser. A site can offer several feeds (xkcd offers Atom and
            RSS; a news site often offers one per section), so this is a
            checkbox list rather than a single-selection picker, and every
            discovered feed starts ticked because subscribing to what you
            asked for is the common case.

            The CheckBox is stretched to fill its row, and the row is stretched
            to fill the list, so a click anywhere on a row toggles it. Left as
            an auto-width CheckBox, clicking the row highlighted it and did
            nothing else, so unticking a feed meant hitting the small box
            exactly.
        -->
        <Border Grid.Row="3" x:Name="DiscoveredListPanel" Classes="settings-card">
            <ListBox x:Name="DiscoveredList" Background="Transparent" BorderThickness="0" Margin="4">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  Content="{Binding Label}"
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!--
            The approval panel, and the whole point of the feature: a page with
            no feed that the detector believes is an index of articles. It is
            NOT a row in the chooser above, and that is deliberate. Every row in
            that list is something the site declared, and every one starts
            ticked; this is mylo guessing at somebody else's markup, and putting
            it in the same list with the same pre-ticked default would let it be
            added by a user who never read it.

            So it is a separate, hidden-by-default panel with its own unticked
            CheckBox, showing the count and a sample of the titles, and Add does
            nothing with it until that box is ticked. It also gives the UI test
            harness a real named route (ScrapeApproveCheck) to the approval,
            which a checkbox inside a ListBox item template does not.

            It shares row 3 with the chooser rather than taking a row of its
            own, and exactly one of the two is ever visible: a scrape is only
            offered when no feed was found, so an empty chooser above it would
            be a card of dead space, and a row of its own would leave the same
            gap behind when the chooser was hidden instead.
        -->
        <Border Grid.Row="3" x:Name="ScrapePanel" Classes="settings-card"
                IsVisible="False" Padding="12,10" VerticalAlignment="Top">
            <StackPanel Spacing="6">
                <TextBlock x:Name="ScrapeSummaryText" Classes="row-secondary" TextWrapping="Wrap" />
                <TextBlock x:Name="ScrapeSampleText" Classes="row-secondary"
                           TextWrapping="Wrap" MaxLines="4" />
                <CheckBox x:Name="ScrapeApproveCheck" IsChecked="False"
                          Content="Treat this page as a feed (scraped, not published)" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="4" ColumnDefinitions="Auto,*" Margin="0,14,0,0">
            <TextBlock Grid.Column="0" Text="Folder" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox Grid.Column="1" x:Name="FolderCombo" HorizontalAlignment="Stretch" />
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Click="OnCancel" Width="80" IsCancel="True" />
            <Button x:Name="AddButton" Content="Add" Click="OnAdd" Width="80" Classes="accent" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
