<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\mylo-version.props" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>

    <AssemblyName>mylo</AssemblyName>
    <RootNamespace>LucidReader</RootNamespace>
    <!-- From mylo-version.props, shared with LucidReader.Core so the
         User-Agent that assembly builds cannot drift from what ships. -->
    <Version>$(MyloVersion)</Version>
    <Product>mylo</Product>
    <Company>mostlylucid</Company>
    <Authors>Scott Galloway</Authors>
    <Copyright>Copyright (c) 2026 Scott Galloway</Copyright>
    <Description>mylo, a native RSS and Atom reader built on the lucidVIEW rendering stack</Description>
    <InformationalVersion>$(Version)</InformationalVersion>
    <FileVersion>$(Version).0</FileVersion>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <RepositoryUrl>https://github.com/scottgal/lucidview</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Windows only. macOS takes its icon from the bundle's CFBundleIconFile
         and Linux from the desktop entry, both of which point at files
         generated by icon/generate-icons.sh from the same SVG. -->
    <ApplicationIcon>icon\mylo.ico</ApplicationIcon>

    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- False on every RID, not only the macOS ones.

         macOS is the hard constraint: self-extracting the SQLite native
         library into a temp directory makes the hardened runtime refuse to
         load it, which kills the app at first database access on a notarised
         build. That argument does not apply on Windows or Linux, so setting
         this true per-RID there to get one real single file was considered
         and rejected, for two reasons.

         First, it buys almost nothing. The bundled user manual is shipped as
         loose files beside the executable (see the Content items below): it
         is markdown read with File.ReadAllText and screenshots resolved as
         paths on disk, so a manual/ directory sits next to mylo whatever this
         setting says. The package is a folder either way, and folding four
         native libraries into the executable only changes how many files are
         in a folder the user unzips as a unit.

         Second, self-extract has a failure mode on Linux that a folder does
         not. The bundle unpacks to DOTNET_BUNDLE_EXTRACT_BASE_DIR, defaulting
         under /var/tmp, and a distribution or site policy that mounts that
         noexec makes the app refuse to start with nothing useful said about
         why. Loose libraries load from beside the executable and never touch
         it.

         So all four platforms get one layout: the executable, its native
         libraries and manual/ beside it. That is the layout the macOS .app
         already carries and the one CI checks, rather than a second shape
         nobody can run here. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <!-- Measured on an M-series Mac, osx-arm64, time from exec to first
         window, five runs each:

                              executable    cold      warm
           compression on       57.8 MiB    1.96 s    485 ms
           compression off     150.6 MiB    3.06 s    376 ms

         On stays. Compression costs 110 ms once the binary is in the page
         cache and saves 1.1 seconds when it is not, because reading 92 MiB
         fewer bytes off disk beats decompressing them. Cold is the launch a
         user actually notices: the first one after downloading, and the first
         one after a reboot. The 62% smaller download is the same argument
         again. -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Publish hygiene. Without these the output carries nine .pdb and .xml
       files copied out of project and package references, among them an 89 KB
       Naiad.xml and a 45 KB LiveMarkdown.Avalonia.xml. None of them is read at
       runtime and shipping them only tells a reader which internals to poke
       at. AllowedReferenceRelatedFileExtensions is what stops the copy: the
       .pdb and .xml sitting next to each referenced assembly are "related
       files", not assets, so no Remove item can reach them. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!--
    AllowedReferenceRelatedFileExtensions above stops the .pdb and .xml beside
    a managed reference. It does not reach a .pdb that a runtime package ships
    as a native asset, because that arrives as a file to publish in its own
    right rather than as a file related to an assembly. SkiaSharp does exactly
    that on Windows: a win-x64 publish came out carrying an 80 MiB
    libSkiaSharp.pdb next to an 11 MiB libSkiaSharp.dll, more than half the
    download, for a symbol file nothing on a user's machine reads. Removing it
    from ResolvedFileToPublish is the only place it can be caught, since by
    then the native assets have been resolved and the list is still editable.
    Release only, so a Debug publish keeps its symbols.
  -->
  <Target Name="DropNativeSymbolsFromPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.12" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.12" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.12" />
    <PackageReference Include="FluentAvaloniaUI" Version="2.5.0" />
    <PackageReference Include="FluentIcons.Avalonia.Fluent" Version="2.0.321" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.12" Condition="'$(Configuration)' == 'Debug'" />

    <!-- Override transitive Tmds.DBus.Protocol 0.21.2 (GHSA-xrw6-gwf8-vvr9), same as MarkdownViewer.csproj. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
  </ItemGroup>

  <!-- The status-item glyphs and the window icon. AvaloniaResource rather
       than loose files so they survive the single-file publish the Release
       build uses. The .icns and .ico deliberately live in icon/ instead: they
       are read by the macOS bundle and the Windows PE header, never by the
       running app, so embedding them would add 150 KB nothing loads. -->
  <ItemGroup>
    <!-- Assets\manual\** is excluded: it is shipped as loose files beside the
         executable (see the Content items below) because the markdown is read
         with File.ReadAllText and its screenshots are resolved as paths on
         disk. Embedding them as well would put a second, unreachable copy of
         every screenshot inside the binary. -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\manual\**" />
  </ItemGroup>

  <!-- The bundled user manual, read by the Help menu and by F1 (see
       LucidReader/Services/UserManual.cs). Loose files rather than
       AvaloniaResource, on purpose and unlike everything in Assets\** above:
       the manual is markdown handed to LucidMarkdownView as text and its
       screenshots are resolved as image paths on disk, neither of which can
       come out of an avares: resource. Copied in every configuration, so the
       Release single-file publish and the macOS .app bundle
       (LucidReader/macos/make-bundle.sh copies the whole publish directory)
       both carry it. Two items rather than a recursive one so the screenshots
       keep their folder and the manual's relative references still line up. -->
  <ItemGroup>
    <Content Include="Assets\manual\user-manual.md" Link="manual\user-manual.md"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\manual\screenshots\*.png"
             Link="manual\screenshots\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LucidReader.Core\LucidReader.Core.csproj" />
    <ProjectReference Include="..\Mostlylucid.LucidView.Markdown\Mostlylucid.LucidView.Markdown.csproj" />
    <ProjectReference Include="..\Mostlylucid.LucidView.Shell\Mostlylucid.LucidView.Shell.csproj" />
    <ProjectReference Include="..\Mostlylucid.LucidView.Content\Mostlylucid.LucidView.Content.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <ProjectReference Include="..\external\lucidRESUME\src\Mostlylucid.Avalonia.UITesting\Mostlylucid.Avalonia.UITesting.csproj" />
    <!--
      Pinned to match the Avalonia version this app uses. The UITesting project
      brings Avalonia.Headless 11.3.4 transitively, and against Avalonia 11.3.12
      that fails at startup with a TypeLoadException: HeadlessClipboardStub has
      no implementation for the SetDataAsync the newer core declares. Debug only,
      like the harness itself, so it never reaches a Release build.
    -->
    <PackageReference Include="Avalonia.Headless" Version="11.3.12" />
  </ItemGroup>

  <!-- Lets LucidReader.Core.Tests exercise ReaderServices.OnRefreshCompleted
       and DownloadQueueLoop directly, to test the disposal-ordering guarantee
       without racing a real HTTP refresh through FeedRefreshService's
       coordinator. Both members stay internal; this does not widen the
       public API. -->
  <ItemGroup>
    <InternalsVisibleTo Include="LucidReader.Core.Tests" />
  </ItemGroup>
</Project>
