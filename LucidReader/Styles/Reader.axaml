<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LucidReader.Views.Controls">

    <!--
        Single home for the values every reading-list task from here on
        inherits: brushes, the row corner radius and the row text styles.
        Light and dark are both scoped under ThemeDictionaries because the
        app follows the system appearance rather than offering a picker
        (MainWindow.axaml.cs's ThemeService only ever applies Light, Dark or
        the OS default).
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <!-- Translucent when TransparencyLevelHint actually gives us a
                         blur behind it; still a legible flat panel when it falls
                         back to opaque (Windows/Linux, or macOS with blur denied). -->
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F0EBEBED" />
                    <SolidColorBrush x:Key="ListBackgroundBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="ReadingBackgroundBrush" Color="#FFFFFFFF" />
                    <!-- The macOS blue the whole app selects with. Exposed as a
                         Color as well as a brush so a dialog can build the theme's
                         own accent brushes (checkbox fills, the accent button) from
                         it rather than inheriting the platform accent. -->
                    <Color x:Key="AccentSelectionColor">#FF0A84FF</Color>
                    <SolidColorBrush x:Key="AccentSelectionBrush" Color="{StaticResource AccentSelectionColor}" />
                    <SolidColorBrush x:Key="AccentSelectionInactiveBrush" Color="#33000000" />
                    <SolidColorBrush x:Key="RowHoverBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="UnreadDotBrush" Color="#FF0A84FF" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#1F000000" />
                    <SolidColorBrush x:Key="RowTitleBrush" Color="#FF1A1A1A" />
                    <SolidColorBrush x:Key="RowSecondaryBrush" Color="#99000000" />
                    <SolidColorBrush x:Key="RowSnippetBrush" Color="#80000000" />
                    <SolidColorBrush x:Key="SectionHeaderBrush" Color="#8A000000" />
                    <SolidColorBrush x:Key="SelectedTitleBrush" Color="#FFFFFFFF" />
                    <!--
                        The sidebar's failing/auto-paused marker. macOS system
                        orange, darkened for light mode so it still passes as
                        readable body-weight text on a near-white sidebar.
                        Deliberately not red: a feed that keeps failing is a
                        warning, not a destructive action.
                    -->
                    <SolidColorBrush x:Key="FeedProblemBrush" Color="#FFB25000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F02C2C2E" />
                    <SolidColorBrush x:Key="ListBackgroundBrush" Color="#FF1C1C1E" />
                    <SolidColorBrush x:Key="ReadingBackgroundBrush" Color="#FF1C1C1E" />
                    <Color x:Key="AccentSelectionColor">#FF0A84FF</Color>
                    <SolidColorBrush x:Key="AccentSelectionBrush" Color="{StaticResource AccentSelectionColor}" />
                    <SolidColorBrush x:Key="AccentSelectionInactiveBrush" Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="RowHoverBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="UnreadDotBrush" Color="#FF409CFF" />
                    <SolidColorBrush x:Key="HairlineBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="RowTitleBrush" Color="#FFF2F2F2" />
                    <SolidColorBrush x:Key="RowSecondaryBrush" Color="#99FFFFFF" />
                    <SolidColorBrush x:Key="RowSnippetBrush" Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="SectionHeaderBrush" Color="#8AFFFFFF" />
                    <SolidColorBrush x:Key="SelectedTitleBrush" Color="#FFFFFFFF" />
                    <SolidColorBrush x:Key="FeedProblemBrush" Color="#FFFF9F0A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Mail's selection is an inset rounded rectangle, not a full-bleed
                 bar: roughly 6px horizontal inset, 5px corner radius. -->
            <Thickness x:Key="RowSelectionMargin">6,1</Thickness>
            <CornerRadius x:Key="RowCornerRadius">5</CornerRadius>
            <Thickness x:Key="RowSelectionThickness">1.5</Thickness>

            <!-- ============ Inset rounded row selection ============ -->
            <!--
                Neither the default Avalonia Fluent template nor
                FluentAvaloniaUI's ListBoxItem gives an inset selection out of
                the box (both draw full-bleed), so this replaces the
                container template rather than trying to reach into someone
                else's template parts by name.
            -->
            <ControlTheme x:Key="ReaderListBoxItemTheme" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <!--
                            The border is always present and always the same
                            thickness, transparent when the row is not
                            selected. A BorderThickness that only appears on
                            selection would inset the content and shift every
                            row's text sideways as the selection moved.
                        -->
                        <Border Name="PART_SelectionBorder"
                                Margin="{DynamicResource RowSelectionMargin}"
                                CornerRadius="{DynamicResource RowCornerRadius}"
                                BorderThickness="{DynamicResource RowSelectionThickness}"
                                BorderBrush="Transparent"
                                Background="Transparent">
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Padding="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter>

                <Style Selector="^:pointerover /template/ Border#PART_SelectionBorder">
                    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
                </Style>
                <!--
                    The selected background itself is set OUTSIDE this
                    ControlTheme (see the ListBox:focus-within rules further
                    down) so it can tell a focused selection (solid accent
                    blue, like Mail's active list) from an unfocused one
                    (a quieter grey, like Mail's when focus has moved to
                    another pane) apart. A plain "^:selected" setter here
                    would not have that distinction available.
                -->
            </ControlTheme>

            <!--
                A segmented control built from the existing RadioButtons
                (All/Unread/Starred) rather than a new control: same
                GroupName and IsChecked bindings as before, only the visual
                template changes, so IsFilterAll/Unread/Starred keep working
                unmodified. No radio bullet in this template at all.
            -->
            <ControlTheme x:Key="SegmentedRadioButtonTheme" TargetType="RadioButton">
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource RowSecondaryBrush}" />
                <Setter Property="Template">
                    <ControlTemplate>
                        <!--
                            Padding is a literal here, not {TemplateBinding
                            Padding}. Fluent ships a plain Style for
                            RadioButton, and a Style outranks a ControlTheme
                            setter, so the Padding set above was losing to it:
                            segments rendered with about 4px of side padding
                            instead of 12, and the content sat off centre
                            inside them (the checked "All" pill had 9px on the
                            left and 0 on the right). MinWidth keeps a short
                            label from collapsing to a stub next to longer
                            ones.
                        -->
                        <Border Name="PART_Segment" CornerRadius="5" Background="Transparent"
                                Padding="14,5" MinWidth="62">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter>

                <Style Selector="^:checked">
                    <Setter Property="Foreground" Value="{DynamicResource SelectedTitleBrush}" />
                </Style>
                <Style Selector="^:checked /template/ Border#PART_Segment">
                    <Setter Property="Background" Value="{DynamicResource AccentSelectionBrush}" />
                </Style>
                <Style Selector="^:not(:checked):pointerover /template/ Border#PART_Segment">
                    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
                </Style>
            </ControlTheme>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ================= Row and section typography ================= -->

    <Style Selector="TextBlock.row-title">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource RowTitleBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style Selector="TextBlock.row-secondary">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{DynamicResource RowSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!--
        The sidebar marker on a feed that is failing or was auto-paused. Same
        metrics as row-secondary so it sits on the row's baseline, but it must
        not read as secondary: at RowSecondaryBrush's 60% alpha the one signal
        that a feed has stopped working was the dimmest thing on the row.
        Selection still overrides this to white further down the file, which
        is correct - on a solid accent fill the orange would be the unreadable
        one.
    -->
    <Style Selector="TextBlock.row-problem">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FeedProblemBrush}" />
    </Style>

    <Style Selector="TextBlock.row-snippet">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource RowSnippetBrush}" />
        <Setter Property="LineHeight" Value="16" />
    </Style>

    <!--
        The query terms inside a search result's matched passage. Weight and
        the title's full-strength colour, not the accent: the accent is what a
        selected row is filled with, and an accent-coloured word would
        disappear the moment the user selected the result they were looking
        at. Same metrics as row-snippet so a highlighted word does not shift
        the line it sits on.
    -->
    <Style Selector="TextBlock.row-snippet.snippet-match">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource RowTitleBrush}" />
    </Style>

    <Style Selector="TextBlock.section-header">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SectionHeaderBrush}" />
    </Style>

    <!--
        Focused vs unfocused selection: a solid accent blue while the item
        list itself has focus (matching Mail's active list), a quieter grey
        once focus moves elsewhere (the search box, the sidebar) so a
        selection doesn't read as "still the thing you're acting on" when
        it isn't.
    -->
    <Style Selector="ListBox:focus-within ListBoxItem:selected /template/ Border#PART_SelectionBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentSelectionBrush}" />
    </Style>
    <Style Selector="ListBox:not(:focus-within) ListBoxItem:selected /template/ Border#PART_SelectionBorder">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentSelectionInactiveBrush}" />
    </Style>

    <!-- A selected row's own text goes white-on-blue, like Mail, rather than
         keeping the secondary greys that would lose contrast against the
         accent fill. -->
    <!--
        Only when focused: the unfocused grey (AccentSelectionInactiveBrush)
        is a translucent overlay, not solid, so white text over it would lose
        contrast in the light theme. Leaving the normal row colours in place
        for an unfocused selection keeps it legible either way.
    -->


    <!-- ================= Hover row actions ================= -->

    <Style Selector="controls|RowActions">
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="Margin" Value="0,6,10,0" />
    </Style>
    <Style Selector="ListBoxItem:pointerover controls|RowActions">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!--
        Transparent, not ListBackgroundBrush. The action bar only appears on
        hover, and on a selected focused row the row underneath is filled with
        AccentSelectionBrush: an opaque list-background rectangle painted over
        that read as a light patch punched out of the selection. The buttons
        inside carry their own hover fill, so they stay legible without one.
    -->
    <Style Selector="StackPanel.row-actions-bar">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Button.row-action">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.row-action:pointerover">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    </Style>

    <!-- ================= Sidebar node row ================= -->
    <!-- A plain Border, not a ListBoxItem: see the remark in MainWindow.axaml
         on why the sidebar uses one ItemsControl per section instead of a
         shared-selection ListBox. Same inset-rounded-rectangle shape as the
         item list's selection, so the two lists read as one visual system. -->
    <Style Selector="Border.node-row">
        <Setter Property="Margin" Value="{DynamicResource RowSelectionMargin}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RowCornerRadius}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Background" Value="Transparent" />
        <!-- Always present, transparent when unselected: see PART_SelectionBorder. -->
        <Setter Property="BorderThickness" Value="{DynamicResource RowSelectionThickness}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.node-row:pointerover">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    </Style>
    <Style Selector="Border.node-row.selected">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentSelectionBrush}" />
    </Style>

    <!-- ================= Sidebar section header ================= -->

    <!--
        A section header is a ToggleButton purely for the checked/unchecked
        state IsExpanded binds to; it must not look like one. Both the base
        FluentAvaloniaUI theme's default (unchecked) and checked-state accent
        fill are overridden here, since IsExpanded defaults to true, which
        means the header would otherwise render as a full-bleed accent bar
        the instant the window opens.
    -->
    <Style Selector="ToggleButton.sidebar-header">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ToggleButton.sidebar-header:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.sidebar-header:checked /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.sidebar-header:checked:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
    </Style>

    <Style Selector="TextBlock.chevron">
        <Setter Property="RenderTransform" Value="rotate(0deg)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="TextBlock.chevron.collapsed">
        <Setter Property="RenderTransform" Value="rotate(-90deg)" />
    </Style>

    <!-- ================= Reading pane header ================= -->

    <Style Selector="TextBlock.article-title">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.article-meta">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource RowSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Rectangle.hairline">
        <Setter Property="Fill" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>

    <!-- ================= Small toolbar buttons ================= -->
    <Style Selector="Button.row-toolbar">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,4" />
    </Style>

    <!--
        The layout button. Squarer and tighter than the labelled buttons
        beside it, because its content is an 18x14 drawing rather than a word,
        and the default 8,4 would leave it looking like a button with its
        label missing.
    -->
    <Style Selector="Button.icon-toolbar">
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
        The per-feed update line's Refresh control. Smaller and quieter than
        row-toolbar: it sits beside a line of secondary text at the top of the
        item list, and a full toolbar button there would be the loudest thing
        in the column and would fight the segmented filter directly below it.
    -->
    <Style Selector="Button.feed-update-refresh">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource RowSecondaryBrush}" />
    </Style>

    <!--
        No :pointerover rule here on purpose. The Fluent button theme sets
        Foreground on the template's ContentPresenter for that state, so a
        Foreground setter on the Button itself would never take effect and
        would sit in this file looking like it did.
    -->

    <!-- ================= Segmented filter control ================= -->
    <Style Selector="Border.segmented-container">
        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <!--
        Reading pane body wrapping: LucidMarkdownView's own inner
        ScrollViewer (its default HorizontalScrollBarVisibility of Auto lets
        the article body measure itself unconstrained and overflow the
        window edge instead of wrapping) is disabled directly in code
        (MainWindow.axaml.cs's constructor) rather than here. Two style
        selector forms were tried first ("md|LucidMarkdownView ScrollViewer"
        and, crossing the UserControl's own template boundary,
        "md|LucidMarkdownView /template/ ScrollViewer") and neither visibly
        took effect in the harness, so this was moved to a direct
        GetVisualDescendants() walk instead of leaving an unverified style
        rule in place.
    -->
</Styles>
