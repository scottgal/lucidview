<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Patched LiveMarkdown.Avalonia + Mostlylucid.Avalonia.UITesting are
         now consumed via submodules under external/ + ProjectReference in
         MarkdownViewer.Full.csproj. No local feeds needed for those.

         local-packages holds the StyloExtract build that LucidReader.Core
         needs and nuget.org does not yet have: 2.0.1 was compiled against
         mostlylucid.ephemeral.sqlite.singlewriter 2.6.4.0, and mylo pins that
         package at 3.0.0, whose assembly version is 2.0.0.0. A reference to a
         higher assembly version than the one on disk does not bind, so
         StyloExtract.Templates 2.0.1 throws FileNotFoundException the moment
         SqliteTemplateIndex is constructed from this repo. The packages here
         are the same source rebuilt against Ephemeral 3.0.0. Delete the folder
         and this source once 2.1.0 is on nuget.org. -->
    <add key="local-packages" value="local-packages" />
  </packageSources>
</configuration>
