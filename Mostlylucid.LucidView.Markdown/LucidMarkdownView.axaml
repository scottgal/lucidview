             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             x:Class="Mostlylucid.LucidView.Markdown.LucidMarkdownView">
    <ScrollViewer>
        <md:MarkdownRenderer x:Name="MdViewer" />
    </ScrollViewer>
</UserControl>
